FROM node:20-slim
WORKDIR /app/sim-worker
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
# Generated by npm run version:write on the host; no .git or secrets enter the image.
COPY engine-version.json ./engine-version.json
COPY --from=shared . /app/shared
USER node
EXPOSE 8090
CMD ["node", "src/index.js"]
