# Copy to .env in this directory, then fill in SIM_WORKER_SECRET.
# Docker Compose passes the same secret to backend and sim-worker.
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the real .env local; it is ignored by Git.
SIM_WORKER_SECRET=Test

# Keep worker threads and backend simulation concurrency aligned.
SIM_WORKER_THREADS=2
