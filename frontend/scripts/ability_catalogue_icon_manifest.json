{
  "canvas_size": 512,
  "default_padding": 36,
  "icons": {
    "slash": {
      "output": "swing.webp",
      "source": "frontend/src/assets/arena/melee-slashes-sheet.png",
      "grid": { "columns": 6, "rows": 2, "frame_index": 0 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 32
    },
    "gun": {
      "output": "fire_gun.webp",
      "source": "frontend/src/assets/arena/abilities/rays/fire-gun.png",
      "selection": "strongest visible ray section",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "grenade": {
      "output": "throw_grenade.webp",
      "source": "frontend/src/assets/arena/abilities/projectiles/grenade/moving-003.png",
      "selection": "supplied moving frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "fireball": {
      "output": "shoot_fireball.webp",
      "source": "frontend/src/assets/arena/abilities/projectiles/fireball/005.png",
      "selection": "strongest fully developed fireball frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "stun": {
      "output": "stun.webp",
      "source": "frontend/src/assets/arena/abilities/stun/stun.png",
      "selection": "supplied single complete frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "heavy_slash": {
      "output": "heavy_slash.webp",
      "source": "frontend/src/assets/arena/melee-slashes-sheet.png",
      "grid": { "columns": 6, "rows": 2, "frame_index": 6 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 32
    },
    "repulsor_burst": {
      "output": "repulsor_burst.webp",
      "source": "frontend/src/assets/arena/abilities/repulsorblast/spritesheet.png",
      "grid": { "columns": 10, "rows": 1, "frame_index": 3 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "concussive_shot": {
      "output": "concussive_shot.webp",
      "source": "frontend/src/assets/arena/abilities/rays/concussive-shot.png",
      "grid": { "columns": 1, "rows": 7, "used_frames": 6, "frame_index": 3 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 38
    },
    "basic_heal": {
      "output": "basic_heal.webp",
      "source": "frontend/src/assets/arena/abilities/support/basic-heal.png",
      "grid": { "columns": 16, "rows": 1, "frame_index": 8 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "proximity_mine": {
      "output": "proximity_mine.webp",
      "source": "frontend/src/assets/arena/abilities/projectiles/mine/static-004.png",
      "selection": "fully armed static presentation",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "pistol": {
      "output": "pistol_shot.webp",
      "layers": [
        {
          "source": "frontend/src/assets/arena/abilities/rays/fire-gun.png",
          "selection": "subtle supporting crop",
          "crop": "alpha",
          "target_extent": 410,
          "opacity": 0.34,
          "anchor": "center"
        },
        {
          "source": "frontend/src/assets/arena/abilities/rays/muzzle-flash.png",
          "grid": { "columns": 4, "rows": 2, "frame_index": 3 },
          "selection": "most visible muzzle-flash frame",
          "crop": "alpha",
          "target_extent": 260,
          "anchor": "center"
        }
      ],
      "composite": "alpha_over_center",
      "padding": 34
    },
    "rail_shot": {
      "output": "rail_shot.webp",
      "source": "frontend/src/assets/arena/abilities/rays/rail-shot.webp",
      "grid": { "columns": 2, "rows": 5, "used_frames": 9, "frame_index": 6 },
      "selection": "exclude tenth green guide cell",
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "gravity_grenade": {
      "output": "gravity_grenade.webp",
      "source": "frontend/src/assets/arena/abilities/zones/gravity-grenade.png",
      "grid": { "columns": 10, "rows": 10, "used_frames": 91, "frame_index": 55 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "silence_pulse": {
      "output": "silence_pulse.webp",
      "source": "frontend/src/assets/arena/abilities/zones/silence-pulse.webp",
      "grid": { "columns": 2, "rows": 3, "used_frames": 5, "frame_index": 2 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "reactive_armor": {
      "output": "reactive_armor.webp",
      "source": "frontend/src/beta/PixiCanvas.jsx#drawStatusSymbol",
      "procedural": "status_symbol",
      "status": "RA",
      "geometry_reference": "drawStatusSymbol(status === RA)",
      "color": "#fbbf24",
      "crop": "alpha",
      "fit": "contain",
      "padding": 74,
      "symbol_scale": 18
    },
    "hunter_drone": {
      "output": "hunter_drone.webp",
      "source": "frontend/src/assets/arena/abilities/bot/drone-design.png",
      "selection": "centered fully visible drone",
      "crop": "alpha",
      "fit": "contain",
      "padding": 48
    },
    "wind_burst": {
      "output": "wind_burst.webp",
      "source": "frontend/src/assets/arena/abilities/wind-burst/atlas_17.webp",
      "grid": { "columns": 1, "rows": 3, "frame_index": 1 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "temporal_rewind": {
      "output": "temporal_rewind.webp",
      "source": "frontend/src/assets/arena/abilities/support/temporal-rewind.png",
      "grid": { "columns": 5, "rows": 3, "frame_index": 7 },
      "selection": "fully formed clock face with visible hands",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "orbital_strike": {
      "output": "orbital_strike.webp",
      "source": "frontend/src/assets/arena/abilities/orbital-strike/orbitalstrike-explosion/spritesheet.png",
      "grid": { "columns": 9, "rows": 1, "frame_index": 4 },
      "selection": "brightest midpoint of explosion",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "absolute_guard": {
      "output": "absolute_guard.webp",
      "source": "frontend/src/beta/PixiCanvas.jsx#drawStatusSymbol",
      "procedural": "status_symbol",
      "status": "AG",
      "geometry_reference": "drawStatusSymbol(status === AG)",
      "color": "#e2e8f0",
      "crop": "alpha",
      "fit": "contain",
      "padding": 74,
      "symbol_scale": 18
    },
    "null_zone": {
      "output": "null_zone.webp",
      "source": "frontend/src/assets/arena/abilities/zones/null-zone.png",
      "grid": { "columns": 5, "rows": 1, "frame_index": 2 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "phase_strike": {
      "output": "phase_strike.webp",
      "source": "frontend/src/assets/arena/abilities/support/phase-strike/004.png",
      "selection": "supplied phase-strike frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 46
    },
    "frost_ring": {
      "output": "frost_ring.webp",
      "source": "frontend/src/assets/arena/abilities/zones/gravity-grenade.png",
      "selection": "temporary catalogue placeholder until the Frost Ring sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "singularity": {
      "output": "singularity.webp",
      "source": "frontend/src/assets/arena/abilities/orbital-strike/orbital-strike-marker.png",
      "selection": "temporary catalogue placeholder until the Singularity sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "tether_bolt": {
      "output": "tether_bolt.webp",
      "source": "frontend/src/assets/arena/abilities/rays/concussive-shot.png",
      "selection": "temporary catalogue placeholder until the Tether Bolt sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 38
    },
    "static_snare": {
      "output": "static_snare.webp",
      "source": "frontend/src/assets/arena/abilities/zones/null-zone.png",
      "selection": "temporary catalogue placeholder until the Static Snare sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "disruptor_dart": {
      "output": "disruptor_dart.webp",
      "source": "frontend/src/assets/arena/abilities/rays/concussive-shot.png",
      "selection": "temporary catalogue placeholder until the Disruptor Dart sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 38
    },
    "repeller_drone": {
      "output": "repeller_drone.webp",
      "source": "frontend/src/assets/arena/abilities/bot/drone-design.png",
      "selection": "temporary catalogue placeholder until the Repeller Drone sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
      "padding": 48
    },
    "siphon_lance": {
      "output": "siphon_lance.webp",
      "source": "frontend/src/assets/arena/abilities/rays/rail-shot.webp",
      "selection": "temporary catalogue placeholder until the Siphon Lance sprite sheet exists",
      "crop": "alpha",
      "fit": "contain",
