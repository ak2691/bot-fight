{
  "canvas_size": 512,
  "default_padding": 36,
  "icons": {
    "swing": {
      "output": "swing.png",
      "source": "frontend/src/assets/arena/melee-slashes-sheet.png",
      "grid": { "columns": 6, "rows": 2, "frame_index": 0 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 32
    },
    "block": {
      "output": "block.png",
      "source": "frontend/src/assets/arena/abilities/shields/regular-shield.png",
      "grid": { "columns": 5, "rows": 4, "frame_index": 12 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "fire_gun": {
      "output": "fire_gun.png",
      "source": "frontend/src/assets/arena/abilities/rays/fire-gun.png",
      "selection": "strongest visible ray section",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "throw_grenade": {
      "output": "throw_grenade.png",
      "source": "frontend/src/assets/arena/abilities/projectiles/grenade/moving-003.png",
      "selection": "supplied moving frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "shoot_fireball": {
      "output": "shoot_fireball.png",
      "source": "frontend/src/assets/arena/abilities/projectiles/fireball/005.png",
      "selection": "strongest fully developed fireball frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "stun": {
      "output": "stun.png",
      "source": "frontend/src/assets/arena/abilities/stun/stun.png",
      "selection": "supplied single complete frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "heavy_slash": {
      "output": "heavy_slash.png",
      "source": "frontend/src/assets/arena/melee-slashes-sheet.png",
      "grid": { "columns": 6, "rows": 2, "frame_index": 6 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 32
    },
    "repulsor_burst": {
      "output": "repulsor_burst.png",
      "source": "frontend/src/assets/arena/abilities/repulsorblast/spritesheet.png",
      "grid": { "columns": 10, "rows": 1, "frame_index": 3 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "concussive_shot": {
      "output": "concussive_shot.png",
      "source": "frontend/src/assets/arena/abilities/rays/concussive-shot.png",
      "grid": { "columns": 1, "rows": 7, "used_frames": 6, "frame_index": 3 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 38
    },
    "basic_heal": {
      "output": "basic_heal.png",
      "source": "frontend/src/assets/arena/abilities/support/basic-heal.png",
      "grid": { "columns": 16, "rows": 1, "frame_index": 8 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "proximity_mine": {
      "output": "proximity_mine.png",
      "source": "frontend/src/assets/arena/abilities/projectiles/mine/static-004.png",
      "selection": "fully armed static presentation",
      "crop": "alpha",
      "fit": "contain",
      "padding": 42
    },
    "pistol_shot": {
      "output": "pistol_shot.png",
      "layers": [
        {
          "source": "frontend/src/assets/arena/abilities/rays/fire-gun.png",
          "selection": "subtle supporting crop",
          "crop": "alpha",
          "target_extent": 410,
          "opacity": 0.34,
          "anchor": "center"
        },
        {
          "source": "frontend/src/assets/arena/abilities/rays/muzzle-flash.png",
          "grid": { "columns": 4, "rows": 2, "frame_index": 3 },
          "selection": "most visible muzzle-flash frame",
          "crop": "alpha",
          "target_extent": 260,
          "anchor": "center"
        }
      ],
      "composite": "alpha_over_center",
      "padding": 34
    },
    "rail_shot": {
      "output": "rail_shot.png",
      "source": "frontend/src/assets/arena/abilities/rays/rail-shot.png",
      "grid": { "columns": 2, "rows": 5, "used_frames": 9, "frame_index": 6 },
      "selection": "exclude tenth green guide cell",
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "gravity_grenade": {
      "output": "gravity_grenade.png",
      "source": "frontend/src/assets/arena/abilities/fields/gravity-grenade.png",
      "grid": { "columns": 10, "rows": 10, "used_frames": 91, "frame_index": 55 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "silence_pulse": {
      "output": "silence_pulse.png",
      "source": "frontend/src/assets/arena/abilities/fields/silence-pulse.png",
      "grid": { "columns": 2, "rows": 3, "used_frames": 5, "frame_index": 2 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "reactive_armor": {
      "output": "reactive_armor.png",
      "source": "frontend/src/beta/PixiCanvas.jsx#drawStatusSymbol",
      "procedural": "status_symbol",
      "status": "RA",
      "geometry_reference": "drawStatusSymbol(status === RA)",
      "color": "#fbbf24",
      "crop": "alpha",
      "fit": "contain",
      "padding": 74,
      "symbol_scale": 18
    },
    "hunter_drone": {
      "output": "hunter_drone.png",
      "source": "frontend/src/assets/arena/abilities/bot/drone-design.png",
      "selection": "centered fully visible drone",
      "crop": "alpha",
      "fit": "contain",
      "padding": 48
    },
    "wind_burst": {
      "output": "wind_burst.png",
      "source": "frontend/src/assets/arena/abilities/wind-burst/atlas_17.png",
      "grid": { "columns": 1, "rows": 3, "frame_index": 1 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "temporal_rewind": {
      "output": "temporal_rewind.png",
      "source": "frontend/src/assets/arena/abilities/support/temporal-rewind.png",
      "grid": { "columns": 5, "rows": 3, "frame_index": 7 },
      "selection": "fully formed clock face with visible hands",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "orbital_strike": {
      "output": "orbital_strike.png",
      "source": "frontend/src/assets/arena/abilities/orbital-strike/orbitalstrike-explosion/spritesheet.png",
      "grid": { "columns": 9, "rows": 1, "frame_index": 4 },
      "selection": "brightest midpoint of explosion",
      "crop": "alpha",
      "fit": "contain",
      "padding": 34
    },
    "absolute_guard": {
      "output": "absolute_guard.png",
      "source": "frontend/src/beta/PixiCanvas.jsx#drawStatusSymbol",
      "procedural": "status_symbol",
      "status": "AG",
      "geometry_reference": "drawStatusSymbol(status === AG)",
      "color": "#e2e8f0",
      "crop": "alpha",
      "fit": "contain",
      "padding": 74,
      "symbol_scale": 18
    },
    "null_zone": {
      "output": "null_zone.png",
      "source": "frontend/src/assets/arena/abilities/fields/null-zone.png",
      "grid": { "columns": 5, "rows": 1, "frame_index": 2 },
      "crop": "alpha",
      "fit": "contain",
      "padding": 28
    },
    "phase_strike": {
      "output": "phase_strike.png",
      "source": "frontend/src/assets/arena/abilities/support/phase-strike/004.png",
      "selection": "supplied phase-strike frame",
      "crop": "alpha",
      "fit": "contain",
      "padding": 46
    }
  }
}
