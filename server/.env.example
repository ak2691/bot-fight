# Copy this file to .env and replace local-only values as needed.
# These values are consumed by Docker Compose from the repository root.
POSTGRES_USER=mladmin
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ml_game_db

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/ml_game_db
SPRING_DATASOURCE_USERNAME=mladmin
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password
SESSION_COOKIE_SECURE=false

# OAuth credentials used only by the backend. Never add these to frontend/.env.
OAUTH_CLIENT_ID=replace-with-your-local-client-id
OAUTH_CLIENT_SECRET=replace-with-your-local-client-secret

PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password

# Used when running with the prod Spring profile.
CORS_ALLOWED_ORIGINS=https://example.com
