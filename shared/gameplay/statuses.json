{
  "version": 1,
  "statuses": {
    "burn": {
      "presenceWhenInside": false,
      "tickIntervalDefaultMs": 1000,
      "carriesSourceSlot": true,
      "clearsVelocity": false,
      "effects": [
        { "type": "damage", "mode": "tick", "amount": "$amount", "multiplier": "$damageMultiplier" }
      ]
    },
    "silence": {
      "presenceWhenInside": true,
      "carriesSourceSlot": false,
      "clearsVelocity": false,
      "effects": [{ "type": "silence", "mode": "constant" }]
    },
    "stun": {
      "presenceWhenInside": false,
      "carriesSourceSlot": false,
      "clearsVelocity": true,
      "effects": [{ "type": "stun", "mode": "constant" }]
    },
    "slow": {
      "presenceWhenInside": false,
      "carriesSourceSlot": false,
      "clearsVelocity": false,
      "effects": [
        {
          "type": "movement_modifier",
          "mode": "constant",
          "movementMultiplier": 0.5,
          "rotationMultiplier": 0.5
        }
      ]
    },
    "shock": {
      "presenceWhenInside": false,
      "tickIntervalDefaultMs": 1000,
      "carriesSourceSlot": true,
      "clearsVelocity": false,
      "effects": [
        { "type": "damage", "mode": "tick", "amount": "$amount" },
        { "type": "movement_lock", "mode": "tick", "durationMs": "$movementLockMs" }
      ]
    },
    "bleed": {
      "presenceWhenInside": false,
      "tickIntervalDefaultMs": 1000,
      "carriesSourceSlot": true,
      "clearsVelocity": false,
      "effects": [
        { "type": "damage", "mode": "tick", "amount": "$amount" },
        {
          "type": "incoming_damage_modifier",
          "mode": "constant",
          "damageModifier": 0.25,
          "rounding": "truncate_tenths",
          "excludedDamageSourceTypes": ["bleed"]
        }
      ]
    }
  }
}
